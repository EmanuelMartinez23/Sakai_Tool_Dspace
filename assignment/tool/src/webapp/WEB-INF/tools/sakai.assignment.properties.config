# EPUB preview/proxy configuration
# Directory for cached EPUB files (default: ${java.io.tmpdir}/sakai-epub-cache)
# assignment.epub.cache.dir = /var/tmp/sakai-epub-cache

# Cache TTL in seconds (default: 86400)
# assignment.epub.cache.ttl.seconds = 86400

# Max EPUB size in bytes (default: 52428800 = 50MB)
# assignment.epub.max.bytes = 52428800

# Allowed upstream hosts for EPUB downloads (CSV)
# assignment.epub.allowedHosts = 127.0.0.1,localhost,192.168.1.27

# DSpace integration (optional). If provided, the proxy puede usar la API autenticada
# para URLs del front de DSpace del tipo /bitstreams/{uuid}/download
# dspace.api.base = http://192.168.1.27:8080/server/api
# dspace.front.base = http://192.168.1.27:4000
# dspace.auth.email = user@example.com
# dspace.auth.password = secret

# Forzar siempre la ruta API para descargas del front de DSpace (opcional, por si el front exige auth)
# assignment.epub.dspace.forceApi = false

# URL de EPUB de demostración para usar como fallback cuando falle la descarga o el host no esté permitido
# (Ejemplo público: Moby Dick)
# assignment.epub.demo.url = https://s3.amazonaws.com/epubjs/books/moby-dick.epub
